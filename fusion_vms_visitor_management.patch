+# --------------------------------------------------------------------------
+# VMS-UC-002 Configure VMS Integration Boundaries
+# --------------------------------------------------------------------------
+
+def configure_integration(actor, key, data):
+    require_super_admin(actor)
+    valid_keys = {k for k, _ in IntegrationKey.CHOICES}
+    errors = {}
+    if key not in valid_keys:
+        errors["key"] = ["Unsupported integration. VMS integrates only with {}.".format(", ".join(sorted(valid_keys)))]
+    endpoint = data.get("endpoint_url", "")
+    if endpoint:
+        try:
+            URLValidator(schemes=["http", "https"])(endpoint)
+        except DjangoValidationError:
+            errors["endpoint_url"] = ["Enter a valid http(s) URL."]
+    settings_value = data.get("settings", {})
+    if settings_value is not None and not isinstance(settings_value, dict):
+        errors["settings"] = ["settings must be a JSON object."]
+    status_value = data.get("status", IntegrationStatus.AVAILABLE)
+    if status_value not in {s for s, _ in IntegrationStatus.CHOICES}:
+        errors["status"] = ["Invalid status."]
+    if errors:
+        # UC-002 exception flow: invalid configuration is rejected and logged.
+        audit.record(actor, VmsRole.SUPER_ADMIN, "INTEGRATION_CONFIG_REJECTED", None,
+                     message="Rejected configuration for {}".format(key), metadata={"errors": errors})
+        raise ValidationFailed("Invalid integration configuration.", details=errors)
+    with transaction.atomic():
+        return _save_integration(actor, key, endpoint, settings_value, status_value, data)
+
+
+def _save_integration(actor, key, endpoint, settings_value, status_value, data):
+    config, _ = IntegrationConfig.objects.get_or_create(key=key)
+    config.endpoint_url = endpoint or ""
+    config.settings = settings_value or {}
+    config.status = status_value
+    config.is_enabled = bool(data.get("is_enabled", True))
+    config.updated_by = actor
+    config.save()
+    audit.record(actor, VmsRole.SUPER_ADMIN, "INTEGRATION_CONFIGURED", config,
+                 message="{} configured ({})".format(key, config.status),
+                 metadata={"enabled": config.is_enabled, "endpoint_url": config.endpoint_url})
+    return config
+
+
+@transaction.atomic
+def rotate_integration_key(actor, key):
+    require_super_admin(actor)
+    if key not in IntegrationKey.KEYED:
+        raise ValidationFailed("This integration does not call VMS and has no API key.", details={"key": [key]})
+    config, _ = IntegrationConfig.objects.get_or_create(key=key)
+    raw = secrets.token_urlsafe(32)
+    config.api_key_hash = hash_secret(raw)
+    config.updated_by = actor
+    config.save(update_fields=["api_key_hash", "updated_by", "updated_at"])
+    audit.record(actor, VmsRole.SUPER_ADMIN, "INTEGRATION_KEY_ROTATED", config, message=key)
+    return config, raw
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-003 Manage VIP Visitor Permissions (VMS-BR-196/197)
+# --------------------------------------------------------------------------
+
+def _vip_values(data, instance=None):
+    errors = {}
+    visit = None
+    if data.get("visit_reference"):
+        visit = VisitRequest.objects.filter(reference=data["visit_reference"]).select_related("visitor").first()
+        if visit is None:
+            errors["visit_reference"] = ["Unknown visit."]
+    identity = {k: data.get(k, getattr(instance, k, "") if instance else "") or "" for k in
+                ("full_name", "id_doc_type", "id_doc_number", "phone", "email")}
+    if visit is None and not (identity["id_doc_number"] or identity["phone"]):
+        errors["identity"] = ["Give the visitor's ID document number or phone, or a visit reference."]
+    valid_from = data.get("valid_from") or (instance.valid_from if instance else now())
+    valid_until = data.get("valid_until") or (instance.valid_until if instance else None)
+    if not valid_until or valid_until <= valid_from:
+        errors["valid_until"] = ["A validity end after valid_from is required."]
+    elif valid_until <= now():
+        errors["valid_until"] = ["An expired VIP permission cannot be granted."]
+    zone_scope = data.get("zone_scope", instance.zone_scope if instance else VipPermission.ZONE_SCOPE_NONE)
+    if zone_scope not in {c for c, _ in VipPermission.ZONE_SCOPE_CHOICES}:
+        errors["zone_scope"] = ["Invalid zone scope."]
+    zones = zones_from_codes(data.get("zones")) if data.get("zones") is not None else None
+    if zone_scope == VipPermission.ZONE_SCOPE_LISTED and not (zones or (instance and instance.zones.exists())):
+        errors["zones"] = ["List the zones the VIP override covers."]
+    if errors:
+        raise ValidationFailed("Invalid VIP permission.", details=errors)
+    if visit is not None:
+        for key in ("full_name", "id_doc_type", "id_doc_number", "phone", "email"):
+            identity[key] = identity[key] or getattr(visit.visitor, key)
+    return visit, identity, valid_from, valid_until, zone_scope, zones
+
+
+@transaction.atomic
+def grant_vip(actor, data):
+    require_super_admin(actor)  # VMS-BR-196
+    visit, identity, valid_from, valid_until, zone_scope, zones = _vip_values(data)
+    permission = VipPermission(
+        visit=visit, valid_from=valid_from, valid_until=valid_until, zone_scope=zone_scope,
+        bypass_host_approval=bool(data.get("bypass_host_approval", True)), notes=data.get("notes", ""),
+        granted_by=actor, **identity
+    )
+    permission.save()
+    if zones is not None:
+        permission.zones.set(zones)
+    audit.record(actor, VmsRole.SUPER_ADMIN, "VIP_GRANTED", permission,
+                 message="VIP permission granted", metadata={"zone_scope": zone_scope, "valid_until": valid_until,
+                                                             "visit": visit.reference if visit else None})
+    return permission
+
+
+@transaction.atomic
+def revise_vip(actor, permission_id, data):
+    require_super_admin(actor)
+    permission = VipPermission.objects.filter(pk=permission_id, is_active=True, revoked_at__isnull=True).first()
+    if permission is None:
+        raise NotFound("Active VIP permission not found.")
+    visit, identity, valid_from, valid_until, zone_scope, zones = _vip_values(data, instance=permission)
+    for key, value in identity.items():
+        setattr(permission, key, value)
+    permission.valid_from, permission.valid_until, permission.zone_scope = valid_from, valid_until, zone_scope
+    if "bypass_host_approval" in data:
+        permission.bypass_host_approval = bool(data["bypass_host_approval"])
+    if "notes" in data:
+        permission.notes = data["notes"]
+    permission.save()
+    if zones is not None:
+        permission.zones.set(zones)
+    audit.record(actor, VmsRole.SUPER_ADMIN, "VIP_REVISED", permission, message="VIP permission revised")
+    return permission
+
+
+@transaction.atomic
+def revoke_vip(actor, permission_id):
+    require_super_admin(actor)
+    permission = VipPermission.objects.filter(pk=permission_id, is_active=True).first()
+    if permission is None:
+        raise NotFound("Active VIP permission not found.")
+    permission.is_active = False
+    permission.revoked_at = now()
+    permission.revoked_by = actor
+    permission.save(update_fields=["is_active", "revoked_at", "revoked_by"])
+    audit.record(actor, VmsRole.SUPER_ADMIN, "VIP_REVOKED", permission, message="VIP permission revoked")
+    return permission
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-005 Manage Access Policies (VMS-BR-125..129)
+# --------------------------------------------------------------------------
+
+POLICY_FIELDS = (
+    "visiting_hours_start", "visiting_hours_end", "max_visit_duration_minutes", "walk_in_pass_duration_minutes",
+    "approval_timeout_minutes", "advance_registration_minutes", "contingency_sla_minutes",
+    "reminder_offsets_minutes", "notes",
+)
+
+BASELINE_POLICY = {
+    "visiting_hours_start": None,
+    "visiting_hours_end": None,
+    "max_visit_duration_minutes": BASELINE_MAX_VISIT_MINUTES,
+    "walk_in_pass_duration_minutes": BASELINE_WALK_IN_PASS_MINUTES,
+    "approval_timeout_minutes": BASELINE_APPROVAL_TIMEOUT_MINUTES,
+    "advance_registration_minutes": BASELINE_ADVANCE_REGISTRATION_MINUTES,
+    "contingency_sla_minutes": BASELINE_CONTINGENCY_SLA_MINUTES,
+    "reminder_offsets_minutes": [],
+    "notes": "",
+}
+
+
+def _validate_policy(values):
+    errors = {}
+    for field in ("max_visit_duration_minutes", "walk_in_pass_duration_minutes", "approval_timeout_minutes",
+                  "contingency_sla_minutes"):
+        if not values.get(field) or int(values[field]) <= 0:
+            errors[field] = ["Must be a positive number of minutes."]
+    if values.get("advance_registration_minutes") is None or int(values["advance_registration_minutes"]) < 0:
+        errors["advance_registration_minutes"] = ["Must be zero or more minutes."]
+    if not errors and values["walk_in_pass_duration_minutes"] > values["max_visit_duration_minutes"]:
+        errors["walk_in_pass_duration_minutes"] = ["Cannot exceed the maximum visit duration."]
+    start, end = values.get("visiting_hours_start"), values.get("visiting_hours_end")
+    if bool(start) != bool(end):
+        errors["visiting_hours"] = ["Give both visiting-hours start and end, or neither."]
+    elif start and end and start >= end:
+        errors["visiting_hours"] = ["Visiting hours must start before they end."]
+    offsets = values.get("reminder_offsets_minutes") or []
+    if not isinstance(offsets, list) or not all(isinstance(o, int) for o in offsets):
+        errors["reminder_offsets_minutes"] = ["Give a list of whole minutes."]
+    elif not errors.get("approval_timeout_minutes") and any(o <= 0 or o >= values["approval_timeout_minutes"] for o in offsets):
+        errors["reminder_offsets_minutes"] = ["Each reminder must fall inside the approval window."]
+    if errors:
+        raise ValidationFailed("Invalid access policy values.", details=errors)
+
+
+@transaction.atomic
+def create_policy_version(actor, data, based_on_version=None):
+    require_campus_admin(actor)
+    base = None
+    if based_on_version:
+        base = AccessPolicy.objects.filter(version=based_on_version).first()
+        if base is None:
+            raise NotFound("Policy version {} not found.".format(based_on_version))
+    values = {f: getattr(base, f) for f in POLICY_FIELDS} if base else dict(BASELINE_POLICY)
+    values.update({k: v for k, v in data.items() if k in POLICY_FIELDS})
+    _validate_policy(values)
+    zone_codes = data.get("restricted_zones")
+    zones = zones_from_codes(zone_codes, "restricted_zones") if zone_codes is not None else (
+        list(base.restricted_zones.all()) if base else [])
+    version = (AccessPolicy.objects.aggregate(v=Max("version"))["v"] or 0) + 1
+    policy = AccessPolicy.objects.create(version=version, status=PolicyStatus.DRAFT, based_on=base,
+                                         created_by=actor, **values)
+    policy.restricted_zones.set(zones)
+    audit.record(actor, VmsRole.ADMIN, "POLICY_DRAFT_CREATED", policy, message="Policy v{} drafted".format(version))
+    return policy
+
+
+@transaction.atomic
+def update_policy_draft(actor, version, data):
+    require_campus_admin(actor)
+    policy = AccessPolicy.objects.select_for_update(of=("self",)).filter(version=version).first()
+    if policy is None:
+        raise NotFound("Policy version not found.")
+    if policy.status != PolicyStatus.DRAFT:
+        # VMS-BR-128: a published version is never mutated; modifications are new versions.
+        raise Conflict("Published policy versions are immutable. Create a new version to modify it.",
+                       code="policy_immutable")
+    values = {f: getattr(policy, f) for f in POLICY_FIELDS}
+    values.update({k: v for k, v in data.items() if k in POLICY_FIELDS})
+    _validate_policy(values)
+    for key, value in values.items():
+        setattr(policy, key, value)
+    policy.save()
+    if data.get("restricted_zones") is not None:
+        policy.restricted_zones.set(zones_from_codes(data["restricted_zones"], "restricted_zones"))
+    audit.record(actor, VmsRole.ADMIN, "POLICY_DRAFT_UPDATED", policy, message="Policy v{} draft updated".format(version))
+    return policy
+
+
+@transaction.atomic
+def publish_policy(actor, version):
+    require_campus_admin(actor)
+    policy = AccessPolicy.objects.select_for_update(of=("self",)).filter(version=version).first()
+    if policy is None:
+        raise NotFound("Policy version not found.")
+    if policy.status != PolicyStatus.DRAFT:
+        raise Conflict("Only a draft policy version can be published.", code="policy_not_draft")
+    _validate_policy({f: getattr(policy, f) for f in POLICY_FIELDS})
+    previous = list(AccessPolicy.objects.select_for_update(of=("self",)).filter(status=PolicyStatus.PUBLISHED))
+    AccessPolicy.objects.filter(pk__in=[p.pk for p in previous]).update(status=PolicyStatus.SUPERSEDED)
+    policy.status = PolicyStatus.PUBLISHED
+    policy.published_at = now()
+    policy.published_by = actor
+    policy.save(update_fields=["status", "published_at", "published_by", "updated_at"])
+    audit.record(actor, VmsRole.ADMIN, "POLICY_PUBLISHED", policy,
+                 message="Policy v{} published".format(version),
+                 metadata={"superseded": [p.version for p in previous]})
+    return policy
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-006 Manage Blacklist/Watchlist and Safe-list Registry (VMS-BR-118..120)
+# --------------------------------------------------------------------------
+
+REGISTRY_FIELDS = ("list_type", "full_name", "id_doc_type", "id_doc_number", "phone", "email", "reason",
+                   "severity", "expires_at", "is_active", "safelist_scope")
+
+
+def _validate_registry_values(values, exclude_ids=()):
+    errors = {}
+    list_type = values.get("list_type")
+    if list_type not in {c for c, _ in RegistryListType.CHOICES}:
+        errors["list_type"] = ["Invalid list type."]
+    if not any(values.get(k) for k in ("full_name", "id_doc_number", "phone", "email")):
+        errors["identity"] = ["Give at least a name, ID number, phone or e-mail."]
+    if list_type in (RegistryListType.BLACKLIST, RegistryListType.WATCHLIST) and not values.get("reason"):
+        errors["reason"] = ["A reason is required (AFR-109)."]
+    if list_type == RegistryListType.SAFELIST:
+        if not (values.get("id_doc_number") or values.get("phone")):
+            errors["identity"] = ["A safe-list entry needs an ID number or phone to match on."]
+        if not values.get("expires_at"):
+            errors["expires_at"] = ["Every temporary safe-list entry must have an expiry (VMS-BR-119)."]
+    if values.get("expires_at") and values["expires_at"] <= now():
+        errors["expires_at"] = ["Expiry must be in the future."]
+    if errors:
+        raise ValidationFailed("Invalid registry record.", details=errors)
+    keys = identity_keys(values.get("full_name"), values.get("id_doc_number"), values.get("phone"), values.get("email"))
+    if keys["id_doc_key"] or keys["phone_key"]:
+        duplicate = RegistryEntry.objects.filter(
+            list_type=list_type, state__in=[RegistryEntryState.DRAFT, RegistryEntryState.PUBLISHED],
+        ).filter(strong_identity_q(keys)).exclude(pk__in=list(exclude_ids))
+        if duplicate.exists():
+            raise Conflict("A {} record for this identity already exists.".format(list_type.lower()),
+                           code="duplicate_registry_entry")
+
+
+@transaction.atomic
+def create_registry_entry(actor, data):
+    require_campus_admin(actor)
+    values = {k: data.get(k) for k in REGISTRY_FIELDS if k in data}
+    values.setdefault("is_active", True)
+    _validate_registry_values(values)
+    entry = RegistryEntry(created_by=actor, state=RegistryEntryState.DRAFT,
+                          **{k: (v if v is not None else "") if k not in ("expires_at", "is_active") else v
+                             for k, v in values.items()})
+    entry.save()
+    audit.record(actor, VmsRole.ADMIN, "REGISTRY_DRAFT_CREATED", entry, message=str(entry))
+    return entry
+
+
+@transaction.atomic
+def revise_registry_entry(actor, entry_id, data):
+    """Drafts change in place; a published entry gets a draft revision (VMS-BR-120)."""
+    require_campus_admin(actor)
+    entry = RegistryEntry.objects.select_for_update(of=("self",)).filter(pk=entry_id).first()
+    if entry is None:
+        raise NotFound("Registry entry not found.")
+    if entry.state not in (RegistryEntryState.DRAFT, RegistryEntryState.PUBLISHED):
+        raise Conflict("Only draft or published entries can be revised.", code="registry_entry_closed")
+    values = {k: getattr(entry, k) for k in REGISTRY_FIELDS}
+    values.update({k: data[k] for k in REGISTRY_FIELDS if k in data})
+    values["list_type"] = entry.list_type
+    if entry.state == RegistryEntryState.DRAFT:
+        _validate_registry_values(values, exclude_ids=[entry.pk, entry.revision_of_id or 0])
+        for key, value in values.items():
+            setattr(entry, key, value if value is not None or key in ("expires_at",) else "")
+        entry.save()
+        audit.record(actor, VmsRole.ADMIN, "REGISTRY_DRAFT_UPDATED", entry, message=str(entry))
+        return entry
+    if entry.revisions.filter(state=RegistryEntryState.DRAFT).exists():
+        raise Conflict("A draft revision of this entry is already pending publication.", code="revision_pending")
+    _validate_registry_values(values, exclude_ids=[entry.pk])
+    draft = RegistryEntry(created_by=actor, state=RegistryEntryState.DRAFT, revision_of=entry,
+                          **{k: (v if v is not None else "") if k not in ("expires_at", "is_active") else v
+                             for k, v in values.items()})
+    draft.save()
+    audit.record(actor, VmsRole.ADMIN, "REGISTRY_REVISION_DRAFTED", draft, message="Revision of entry {}".format(entry.pk))
+    return draft
+
+
+@transaction.atomic
+def discard_registry_draft(actor, entry_id):
+    require_campus_admin(actor)
+    entry = RegistryEntry.objects.filter(pk=entry_id, state=RegistryEntryState.DRAFT).first()
+    if entry is None:
+        raise NotFound("Draft registry entry not found.")
+    entry.state = RegistryEntryState.DISCARDED
+    entry.save(update_fields=["state"])
+    audit.record(actor, VmsRole.ADMIN, "REGISTRY_DRAFT_DISCARDED", entry, message=str(entry))
+    return entry
+
+
+@transaction.atomic
+def publish_registry(actor, notes=""):
+    require_campus_admin(actor)
+    drafts = list(RegistryEntry.objects.select_for_update(of=("self",)).filter(state=RegistryEntryState.DRAFT))
+    if not drafts:
+        raise Conflict("There are no draft registry changes to publish.", code="nothing_to_publish")
+    version = (RegistryPublication.objects.aggregate(v=Max("version"))["v"] or 0) + 1
+    publication = RegistryPublication.objects.create(version=version, published_by=actor,
+                                                     entries_changed=len(drafts), notes=notes)
+    superseded_ids = [d.revision_of_id for d in drafts if d.revision_of_id]
+    RegistryEntry.objects.filter(pk__in=superseded_ids, state=RegistryEntryState.PUBLISHED).update(
+        state=RegistryEntryState.SUPERSEDED)
+    RegistryEntry.objects.filter(pk__in=[d.pk for d in drafts]).update(
+        state=RegistryEntryState.PUBLISHED, publication=publication)
+    audit.record(actor, VmsRole.ADMIN, "REGISTRY_PUBLISHED", publication,
+                 message="Registry v{} published with {} change(s)".format(version, len(drafts)))
+    return publication
diff --git a/FusionIIIT/applications/visitor_management/services/emergency.py b/FusionIIIT/applications/visitor_management/services/emergency.py
new file mode 100644
index 0000000..ff7b16d
--- /dev/null
+++ b/FusionIIIT/applications/visitor_management/services/emergency.py
@@ -0,0 +1,153 @@
+"""Emergency muster services: VMS-UC-026/032 trigger, VMS-UC-027 roll-call (CW-VMS-06)."""
+
+from django.db import transaction
+from django.utils.dateparse import parse_datetime
+
+from .. import audit
+from ..constants import MusterStatus, NotificationEvent, RollCallStatus, RosterSource, VisitStatus, VmsRole
+from ..errors import Conflict, NotAuthorized, NotFound, ValidationFailed
+from ..models import EmergencyMuster, MusterRosterEntry, VisitRequest
+from ..notifications import notify_user, notify_users, notify_visitor
+from ..selectors import admins_covering, is_admin, is_security, now, security_users
+
+DEFAULT_INSTRUCTIONS = "Please proceed calmly to the nearest assembly point and report to security staff."
+
+
+def _host_name(visit):
+    return visit.host.user.get_full_name() or visit.host.user.username
+
+
+def _entry_for(muster, visit, live=True, cached=False, compare=False):
+    return MusterRosterEntry.objects.create(
+        muster=muster, visit=visit, visitor_name=visit.visitor.full_name, visitor_phone=visit.visitor.phone,
+        visitor_email=visit.visitor.email, host_name=_host_name(visit),
+        host_contact=visit.host.user.email or "",
+        last_seen_zone=visit.last_seen_zone.name if visit.last_seen_zone_id else "",
+        last_seen_at=visit.last_seen_at or visit.check_in_at, in_live_roster=live, in_cached_roster=cached,
+        discrepancy=compare and live != cached,
+    )
+
+
+@transaction.atomic
+def trigger_muster(actor, as_role, instructions="", cached_roster=None, offline_triggered_at=None):
+    """VMS-BR-130: an authorised Admin (UC-026) or Security Personnel (UC-032) may trigger."""
+    if as_role == VmsRole.ADMIN and not is_admin(actor):
+        raise NotAuthorized("An active VMS Admin role is required.")
+    if as_role == VmsRole.SECURITY and not is_security(actor):
+        raise NotAuthorized("An active Security Personnel role is required.")
+    if EmergencyMuster.objects.select_for_update(of=("self",)).filter(status=MusterStatus.ACTIVE).first() is not None:
+        raise Conflict("An emergency muster is already active.", code="muster_active")
+    current = now()
+    muster = EmergencyMuster.objects.create(
+        triggered_by=actor, triggered_by_role=as_role,
+        triggered_at=parse_datetime(offline_triggered_at) if isinstance(offline_triggered_at, str) else (
+            offline_triggered_at or current),
+        assembly_instructions=(instructions or "").strip() or DEFAULT_INSTRUCTIONS,
+        roster_source=RosterSource.CACHED if cached_roster is not None else RosterSource.LIVE,
+    )
+    live = {v.reference: v for v in VisitRequest.objects.filter(status__in=VisitStatus.ON_CAMPUS).select_related(
+        "visitor", "host__user", "last_seen_zone")}
+    cached_refs = set(cached_roster or [])
+    unknown = sorted(r for r in cached_refs if r not in live and not VisitRequest.objects.filter(reference=r).exists())
+    for reference, visit in live.items():
+        _entry_for(muster, visit, live=True, cached=reference in cached_refs, compare=cached_roster is not None)
+    # AFR-140/141: visitors only on the cached roster are kept and flagged, not dropped.
+    for visit in VisitRequest.objects.filter(reference__in=cached_refs - set(live)).select_related(
+            "visitor", "host__user", "last_seen_zone"):
+        _entry_for(muster, visit, live=False, cached=True, compare=True)
+    if unknown:
+        muster.roster_incomplete = True
+        muster.roster_note = "Cached roster referenced unknown visits: {}".format(", ".join(unknown))
+        muster.save(update_fields=["roster_incomplete", "roster_note"])
+    audit.record(actor, as_role, "EMERGENCY_MUSTER_TRIGGERED", muster,
+                 metadata={"roster_size": muster.roster.count(), "source": muster.roster_source})
+    # AFR-138/139: visitor alerts with assembly instructions (SMS where configured).
+    for entry in muster.roster.select_related("visit", "visit__visitor", "visit__host__user"):
+        notify_visitor(entry.visit.visitor, NotificationEvent.EMERGENCY_MUSTER, "EMERGENCY: campus muster",
+                       muster.assembly_instructions, visit=entry.visit, sms=True)
+        notify_user(entry.visit.host.user, NotificationEvent.EMERGENCY_MUSTER, "Emergency muster: your visitor",
+                    "{} is on campus. {}".format(entry.visitor_name, muster.assembly_instructions), visit=entry.visit)
+    responders = {u.pk: u for u in admins_covering() + security_users()}
+    notify_users(list(responders.values()), NotificationEvent.EMERGENCY_MUSTER, "Emergency muster active",
+                 "Muster triggered; {} visitor(s) on the roster.".format(muster.roster.count()))
+    return muster
+
+
+def _active_muster(muster_id):
+    muster = EmergencyMuster.objects.select_for_update(of=("self",)).filter(pk=muster_id).first()
+    if muster is None:
+        raise NotFound("Muster not found.")
+    if muster.status != MusterStatus.ACTIVE:
+        raise Conflict("This muster is already completed.", code="muster_completed")
+    return muster
+
+
+@transaction.atomic
+def update_roll_call(actor, muster_id, updates, source="live"):
+    """VMS-UC-027 roll-call; ``source='cached'`` replays offline updates without overwriting newer ones."""
+    if not is_security(actor):
+        raise NotAuthorized("Only Security Personnel perform roll-call.")
+    muster = _active_muster(muster_id)
+    valid = {s for s, _ in RollCallStatus.CHOICES}
+    applied, skipped = [], []
+    for item in updates or []:
+        status = item.get("status")
+        if status not in valid:
+            raise ValidationFailed("Invalid roll-call status.", details={"status": [status]})
+        entry = muster.roster.filter(pk=item.get("entry_id")).first() if item.get("entry_id") else \
+            muster.roster.filter(visit__reference=item.get("reference")).first()
+        if entry is None:
+            skipped.append({"item": item, "detail": "Not on this muster roster."})
+            continue
+        recorded_at = parse_datetime(item["recorded_at"]) if isinstance(item.get("recorded_at"), str) else item.get(
+            "recorded_at")
+        recorded_at = recorded_at or now()
+        if source == "cached" and entry.updated_at and entry.updated_at >= recorded_at:
+            skipped.append({"item": item, "detail": "A newer roll-call update already exists."})
+            continue
+        entry.status = status
+        entry.note = item.get("note", entry.note)
+        entry.updated_by, entry.updated_at = actor, recorded_at
+        if source == "cached":
+            entry.in_cached_roster = True
+        entry.save()
+        applied.append(entry.pk)
+    audit.record(actor, VmsRole.SECURITY, "ROLL_CALL_UPDATED", muster,
+                 metadata={"applied": applied, "skipped": len(skipped), "source": source})
+    return applied, skipped
+
+
+def build_report(muster):
+    roster = list(muster.roster.all())
+    counts = {s: sum(1 for e in roster if e.status == s) for s, _ in RollCallStatus.CHOICES}
+    return {
+        "muster_id": muster.pk,
+        "triggered_at": muster.triggered_at.isoformat(),
+        "triggered_by_role": muster.triggered_by_role,
+        "finalized_at": muster.finalized_at.isoformat() if muster.finalized_at else None,
+        "roster_source": muster.roster_source,
+        "roster_incomplete": muster.roster_incomplete,
+        "roster_note": muster.roster_note,
+        "total": len(roster),
+        "counts": counts,
+        "unresolved": [{"reference": e.visit.reference, "visitor": e.visitor_name, "phone": e.visitor_phone,
+                        "host": e.host_name, "last_seen_zone": e.last_seen_zone,
+                        "last_seen_at": e.last_seen_at.isoformat() if e.last_seen_at else None}
+                       for e in roster if e.status == RollCallStatus.PENDING],
+        "discrepancies": [e.visit.reference for e in roster if e.discrepancy],
+    }
+
+
+@transaction.atomic
+def finalize_muster(actor, muster_id):
+    if not (is_security(actor) or is_admin(actor)):
+        raise NotAuthorized("Only Security Personnel or Admin can finalise the muster.")
+    muster = _active_muster(muster_id)
+    muster.status = MusterStatus.COMPLETED
+    muster.finalized_at, muster.finalized_by = now(), actor
+    # Unaccounted visitors stay PENDING in the report; nobody is silently marked safe.
+    muster.report = build_report(muster)
+    muster.save()
+    audit.record(actor, VmsRole.SECURITY if is_security(actor) else VmsRole.ADMIN, "EMERGENCY_MUSTER_COMPLETED",
+                 muster, metadata=muster.report["counts"])
+    return muster
diff --git a/FusionIIIT/applications/visitor_management/services/gate.py b/FusionIIIT/applications/visitor_management/services/gate.py
new file mode 100644
index 0000000..0b0edb1
--- /dev/null
+++ b/FusionIIIT/applications/visitor_management/services/gate.py
@@ -0,0 +1,688 @@
+"""Gate, checkout, offline and zone services.
+
+VMS-UC-018 gate validation, VMS-UC-019 manual override, VMS-UC-020 manual visit
+log, VMS-UC-021/031 checkout, VMS-UC-028/039 offline entry and reconciliation,
+VMS-UC-023/024/025 zone access, elevation and alert handling.
+"""
+
+import datetime
+
+from django.db import transaction
+
+from .. import audit, conf, workflow
+from ..constants import (
+    AlertStatus,
+    AlertType,
+    Checkpoint,
+    CredentialType,
+    EventStatus,
+    GateAttemptStatus,
+    GateFailure,
+    LogMethod,
+    LogType,
+    NotificationEvent,
+    OfflineEventStatus,
+    VisitStatus,
+    VmsRole,
+)
+from ..errors import Conflict, NotAuthorized, NotFound, Unavailable, ValidationFailed
+from ..models import (
+    Gate,
+    GateAttempt,
+    OfflineGateEvent,
+    SecurityAlert,
+    VisitLog,
+    VisitPass,
+    VisitRequest,
+    Zone,
+    ZoneElevation,
+)
+from ..notifications import notify_role, notify_user, notify_users
+from ..selectors import admin_covers, admins_covering, now, security_covers, security_users
+from .common import (
+    deactivate_pass,
+    mask,
+    raise_registry_alerts,
+    registry_check,
+    route_admin,
+    zone_permission,
+    zones_from_codes,
+)
+
+CREDENTIAL_METHOD = {
+    CredentialType.QR: LogMethod.QR,
+    CredentialType.BARCODE: LogMethod.QR,
+    CredentialType.OTP: LogMethod.OTP,
+    CredentialType.BADGE: LogMethod.BADGE,
+}
+
+
+def get_gate(code, required=True):
+    if not code:
+        if required:
+            raise ValidationFailed("A gate is required.", details={"gate": ["required"]})
+        return None
+    gate = Gate.objects.select_related("zone").filter(code=code, is_active=True).first()
+    if gate is None:
+        raise ValidationFailed("Unknown or inactive gate.", details={"gate": [code]})
+    return gate
+
+
+def resolve_pass(credential_type, credential, otp=None):
+    """QR -> qr_token; BARCODE/BADGE -> pass number; OTP -> pass number + one-time OTP."""
+    credential = (credential or "").strip()
+    if not credential:
+        return None
+    query = VisitPass.objects.select_related("visit", "visit__visitor", "visit__host__user")
+    if credential_type == CredentialType.QR:
+        return query.filter(qr_token=credential).first()
+    visit_pass = query.filter(pass_number=credential.upper()).first()
+    if credential_type == CredentialType.OTP:
+        if visit_pass is None or not otp or visit_pass.otp != str(otp).strip():
+            return None
+    return visit_pass
+
+
+def _log(visit, log_type, method, actor, at=None, gate=None, zone=None, device_id="", detail="", **extra):
+    hostel = bool((zone and zone.is_hostel_area) or (gate and gate.zone_id and gate.zone.is_hostel_area))
+    return VisitLog.objects.create(
+        visit=visit, log_type=log_type, method=method, occurred_at=at or now(), gate=gate, zone=zone,
+        device_id=device_id or "", recorded_by=actor if (actor and actor.is_authenticated) else None,
+        detail=detail, hostel_area=hostel, **extra)
+
+
+def visit_summary(visit):
+    visit_pass = getattr(visit, "visit_pass", None)
+    return {
+        "reference": visit.reference,
+        "status": visit.status,
+        "visitor": visit.visitor.full_name,
+        "organization": visit.visitor.organization,
+        "photo": visit.visitor.photo.url if visit.visitor.photo else None,
+        "host": visit.host.user.get_full_name() or visit.host.user.username,
+        "special_instructions": visit.special_instructions,
+        "pass_type": visit_pass.pass_type if visit_pass else None,
+        "valid_until": visit_pass.valid_until if visit_pass else None,
+        "permitted_zones": list(visit_pass.permitted_zones.values_list("code", flat=True)) if visit_pass else [],
+        "watchlist_flag": visit.watchlist_flag,
+    }
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-018 Validate Visitor Pass at Gate
+# --------------------------------------------------------------------------
+
+def _gate_failures(visit_pass, credential_type, gate, current, actor):
+    failures, registry_result = [], None
+    if visit_pass is None:
+        return [GateFailure.UNKNOWN_CREDENTIAL], None
+    visit = visit_pass.visit
+    if not visit_pass.is_active:
+        failures.append(GateFailure.PASS_INACTIVE)                       # VMS-BR-077
+    if visit.status != VisitStatus.PASS_ACTIVE:
+        failures.append(GateFailure.VISIT_NOT_ENTERABLE)
+    if not (visit_pass.valid_from <= current <= visit_pass.valid_until):
+        failures.append(GateFailure.OUTSIDE_VALIDITY_WINDOW)             # VMS-BR-190
+    if credential_type == CredentialType.OTP and visit_pass.otp_used_at:
+        failures.append(GateFailure.OTP_ALREADY_USED)
+    registry_result = registry_check(visit.visitor, Checkpoint.GATE, current)  # VMS-BR-112/120
+    if registry_result.disqualifying:
+        failures.append(GateFailure.BLACKLIST_MATCH)                     # VMS-BR-116
+    if gate is not None and gate.zone_id:
+        allowed, _ = zone_permission(visit, gate.zone, current)          # AFR-080
+        if not allowed:
+            failures.append(GateFailure.GATE_ZONE_NOT_PERMITTED)
+    return failures, registry_result
+
+
+@transaction.atomic
+def validate_at_gate(actor, data):
+    current = now()
+    gate = get_gate(data.get("gate"))
+    if not security_covers(actor, gate=gate):
+        raise NotAuthorized("Only Security Personnel assigned to this gate can validate passes.")
+    credential_type = data.get("credential_type")
+    if credential_type not in {c for c, _ in CredentialType.CHOICES}:
+        raise ValidationFailed("Unsupported credential type.", details={"credential_type": [credential_type]})
+    visit_pass = resolve_pass(credential_type, data.get("credential"), data.get("otp"))
+    if visit_pass is not None:
+        visit_pass = VisitPass.objects.select_for_update(of=("self",)).select_related(
+            "visit", "visit__visitor", "visit__host__user").get(pk=visit_pass.pk)
+    visit = visit_pass.visit if visit_pass else None
+    lane = data.get("lane") or VisitRequest.LANE_NORMAL
+    if lane == VisitRequest.LANE_FAST:
+        # AFR-160: same validation obligations, only for events that enabled the lane.
+        event = visit.event if visit else None
+        if event is None or not event.fast_lane_enabled or event.status != EventStatus.CONTROLS_ACTIVE:
+            raise ValidationFailed("Fast-lane scanning is not enabled for this pass.", code="lane_disabled")
+
+    failures, registry_result = _gate_failures(visit_pass, credential_type, gate, current, actor)
+    flagged = bool(registry_result and (registry_result.disqualifying or registry_result.flags))
+    attempt = GateAttempt.objects.create(
+        visit=visit, gate=gate, device_id=data.get("device_id", ""), credential_type=credential_type,
+        credential_hint=mask(data.get("credential", "")), lane=lane,
+        status=GateAttemptStatus.BLOCKED if failures else GateAttemptStatus.ALLOWED,
+        failure_reasons=failures, flagged=flagged, attempted_by=actor, attempted_at=current,
+        override_eligible=bool(failures and visit and set(failures) <= conf.override_eligible_failures()),
+    )
+    if registry_result and (registry_result.disqualifying or registry_result.flags):
+        raise_registry_alerts(registry_result, Checkpoint.GATE, actor=actor, actor_role=VmsRole.SECURITY,
+                              visitor=visit.visitor, visit=visit, gate=gate, gate_attempt=attempt,
+                              identity={"full_name": visit.visitor.full_name, "phone": visit.visitor.phone,
+                                        "email": visit.visitor.email, "id_doc_number": visit.visitor.id_doc_number})
+
+    if failures:
+        # VMS-BR-082: block and record the reason (AFR-082/083/084).
+        _log(visit, LogType.ACCESS_DENIED, CREDENTIAL_METHOD.get(credential_type, LogMethod.QR), actor, current,
+             gate=gate, device_id=data.get("device_id", ""), detail=", ".join(failures), gate_attempt=attempt)
+        audit.record(actor, VmsRole.SECURITY, "GATE_ENTRY_BLOCKED", attempt,
+                     visitor=visit.visitor if visit else None, message=", ".join(failures),
+                     metadata={"gate": gate.code, "visit": visit.reference if visit else None})
+        return {"allowed": False, "attempt_id": attempt.pk, "failure_reasons": failures,
+                "override_eligible": attempt.override_eligible, "flagged": flagged,
+                "visit": visit_summary(visit) if visit else None}
+
+    visit.check_in_at = current
+    visit.entry_gate = gate
+    visit.last_seen_zone = gate.zone
+    visit.last_seen_at = current
+    workflow.apply(visit, "GATE_CHECK_IN", actor=actor, actor_role=VmsRole.SECURITY)
+    if credential_type == CredentialType.OTP:
+        visit_pass.otp_used_at = current
+        visit_pass.save(update_fields=["otp_used_at"])
+    _log(visit, LogType.CHECK_IN, CREDENTIAL_METHOD[credential_type], actor, current, gate=gate,
+         zone=gate.zone, device_id=data.get("device_id", ""), gate_attempt=attempt,
+         detail="Fast lane" if lane == VisitRequest.LANE_FAST else "")
+    audit.record(actor, VmsRole.SECURITY, "VISITOR_CHECKED_IN", visit, visitor=visit.visitor,
+                 metadata={"gate": gate.code, "device_id": data.get("device_id", ""), "lane": lane})
+    notify_user(visit.host.user, NotificationEvent.VISITOR_CHECKED_IN, "Your visitor has arrived",
+                "{} checked in at {} ({}).".format(visit.visitor.full_name, gate.name, current.strftime("%H:%M")),
+                visit=visit, email=False)  # AFR-019 / AFR-168
+    return {"allowed": True, "attempt_id": attempt.pk, "failure_reasons": [], "visit": visit_summary(visit)}
+
+
+@transaction.atomic
+def refer_attempt(actor, attempt_id, note=""):
+    """VMS-UC-018 alt flow: refer an override-eligible block to Admin (VMS-UC-019)."""
+    attempt = GateAttempt.objects.select_for_update(of=("self",)).select_related("gate", "visit").filter(pk=attempt_id).first()
+    if attempt is None:
+        raise NotFound("Gate attempt not found.")
+    if not security_covers(actor, gate=attempt.gate):
+        raise NotAuthorized("Only Security Personnel at this gate can refer the attempt.")
+    if attempt.status != GateAttemptStatus.BLOCKED:
+        raise Conflict("Only blocked attempts can be referred.", code="not_blocked")
+    if not attempt.override_eligible:
+        raise Conflict("This failure type is not eligible for override.", code="not_override_eligible")
+    zones = list(attempt.visit.requested_zones.all()) if attempt.visit else []
+    attempt.assigned_admin = route_admin(zones, attempt.gate)
+    attempt.override_requested_at = now()
+    attempt.escalation_note = note
+    attempt.save(update_fields=["assigned_admin", "override_requested_at", "escalation_note"])
+    if attempt.assigned_admin:
+        notify_user(attempt.assigned_admin, NotificationEvent.OVERRIDE_REQUESTED, "Gate override requested",
+                    "Blocked entry at {} ({}). Reasons: {}.".format(
+                        attempt.gate.name if attempt.gate else "gate",
+                        attempt.visit.reference if attempt.visit else "unknown", ", ".join(attempt.failure_reasons)),
+                    visit=attempt.visit)
+    audit.record(actor, VmsRole.SECURITY, "GATE_OVERRIDE_REQUESTED", attempt, message=note)
+    return attempt
+
