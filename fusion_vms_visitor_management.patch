+# --------------------------------------------------------------------------
+# VMS-UC-025 Handle Zone Violation Alert / suspicious-case escalation (AFR-024)
+# --------------------------------------------------------------------------
+
+@transaction.atomic
+def handle_alert(actor, alert_id, outcome, note):
+    from ..selectors import is_admin, is_security
+    alert = SecurityAlert.objects.select_for_update(of=("self",)).select_related("zone", "gate", "visit").filter(pk=alert_id).first()
+    if alert is None:
+        raise NotFound("Alert not found.")
+    if not (is_security(actor) or is_admin(actor)):
+        raise NotAuthorized("Only Security Personnel or Admin can handle alerts.")
+    if not (note or "").strip():
+        raise ValidationFailed("Record the handling outcome.", details={"note": ["required"]})
+    if outcome not in (AlertStatus.HANDLED, AlertStatus.ESCALATED, AlertStatus.FALSE_ALARM):
+        raise ValidationFailed("outcome must be HANDLED, ESCALATED or FALSE_ALARM.", details={"outcome": [outcome]})
+    if alert.status not in (AlertStatus.OPEN, AlertStatus.ESCALATED):
+        raise Conflict("This alert is already closed.", code="alert_closed")
+    if outcome == AlertStatus.ESCALATED and alert.status == AlertStatus.ESCALATED:
+        raise Conflict("This alert is already escalated.", code="alert_escalated")
+    alert.status = outcome
+    alert.handled_by, alert.handled_at, alert.handling_note = actor, now(), note.strip()
+    if outcome == AlertStatus.ESCALATED:
+        alert.escalated_to_admin = True
+        notify_users(admins_covering(zones=[alert.zone] if alert.zone else (), gate=alert.gate),
+                     NotificationEvent.ALERT_ESCALATED, "Security alert escalated", alert.message + " " + note,
+                     visit=alert.visit)
+    alert.save()
+    audit.record(actor, VmsRole.SECURITY, "ALERT_" + outcome, alert, visitor=alert.visitor, message=note)
+    return alert
+
+
+@transaction.atomic
+def escalate_suspicious_case(actor, data):
+    from ..selectors import is_security
+    if not is_security(actor):
+        raise NotAuthorized("Only Security Personnel can escalate suspicious cases.")
+    if not (data.get("note") or "").strip():
+        raise ValidationFailed("Describe the suspicious case.", details={"note": ["required"]})
+    visit = VisitRequest.objects.filter(reference=data.get("reference")).first() if data.get("reference") else None
+    attempt = GateAttempt.objects.filter(pk=data.get("attempt_id")).first() if data.get("attempt_id") else None
+    gate = attempt.gate if attempt else get_gate(data.get("gate"), required=False)
+    if visit is None and attempt is not None:
+        visit = attempt.visit
+    alert = SecurityAlert.objects.create(
+        alert_type=AlertType.SUSPICIOUS_CASE, status=AlertStatus.ESCALATED, escalated_to_admin=True,
+        visit=visit, visitor=visit.visitor if visit else None, gate=gate, gate_attempt=attempt,
+        message=data["note"].strip(), handled_by=actor, handled_at=now(),
+    )
+    notify_users(admins_covering(gate=gate), NotificationEvent.ALERT_ESCALATED, "Suspicious case escalated",
+                 alert.message, visit=visit)
+    audit.record(actor, VmsRole.SECURITY, "SUSPICIOUS_CASE_ESCALATED", alert, visitor=alert.visitor,
+                 message=alert.message)
+    return alert
diff --git a/FusionIIIT/applications/visitor_management/services/lifecycle.py b/FusionIIIT/applications/visitor_management/services/lifecycle.py
new file mode 100644
index 0000000..08f12d8
--- /dev/null
+++ b/FusionIIIT/applications/visitor_management/services/lifecycle.py
@@ -0,0 +1,266 @@
+"""Cross-cutting lifecycle services.
+
+VMS-UC-016/036 early termination, VMS-UC-034 extension, and the event-triggered
+services VMS-UC-037 (expiry), VMS-UC-038 (automatic checkout), VMS-UC-039
+(offline reconciliation) and VMS-UC-040 (approval reminders).
+"""
+
+from django.db import transaction
+
+from .. import audit, workflow
+from ..constants import ExtensionStatus, LogMethod, NotificationEvent, VisitStatus, VmsRole
+from ..errors import Conflict, NotAuthorized, NotFound, ValidationFailed
+from ..models import ExtensionRequest, VisitRequest
+from ..notifications import notify_role, notify_user, notify_visitor
+from ..selectors import admin_covers, host_extrainfo, now
+from .common import deactivate_pass, minutes, route_admin, visit_zone_set
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-016 / VMS-UC-036 Terminate Visitor Visit Early (VMS-BR-073)
+# --------------------------------------------------------------------------
+
+@transaction.atomic
+def terminate_visit(actor, reference, reason, as_role):
+    visit = VisitRequest.objects.select_for_update(of=("self",)).select_related("visitor", "host__user").filter(
+        reference=reference).first()
+    if visit is None:
+        raise NotFound("Visit not found.")
+    if not (reason or "").strip():
+        raise ValidationFailed("A policy-breach reason is required.", details={"reason": ["required"]})
+    if as_role == VmsRole.HOST:
+        host = host_extrainfo(actor)
+        if host is None or host.pk != visit.host_id:
+            raise NotAuthorized("Only the visit's Host can terminate it.")
+        actions = ("HOST_TERMINATE_BEFORE_CHECK_IN", "HOST_TERMINATE_ON_SITE")
+    else:
+        if not admin_covers(actor, zones=visit_zone_set(visit), gate=visit.entry_gate or visit.registration_gate):
+            raise NotAuthorized("You are not an authorised Admin for this visit.")
+        actions = ("ADMIN_TERMINATE_BEFORE_CHECK_IN", "ADMIN_TERMINATE_ON_SITE")
+    visit_pass = getattr(visit, "visit_pass", None)
+    if visit_pass is None or not visit_pass.is_active:
+        raise Conflict("The pass is already inactive.", code="already_inactive")
+    if visit.status == VisitStatus.PASS_ACTIVE:
+        action = actions[0]
+    elif visit.status == VisitStatus.ON_SITE:
+        action = actions[1]
+    else:
+        raise Conflict("Only an active pass or on-site visit can be terminated.", code="not_active")
+    current = now()
+    visit.terminated_at, visit.terminated_by, visit.termination_reason = current, actor, reason.strip()
+    workflow.apply(visit, action, actor=actor, actor_role=as_role, note=reason.strip())
+    deactivate_pass(visit_pass, actor, "TERMINATED: " + reason.strip())
+    audit.record(actor, as_role, "VISIT_TERMINATED", visit, visitor=visit.visitor, message=reason.strip(),
+                 metadata={"status": visit.status})
+    notify_visitor(visit.visitor, NotificationEvent.VISIT_TERMINATED, "Visit authorisation ended",
+                   "Your pass for visit {} has been deactivated.{}".format(
+                       visit.reference, " Please proceed to the exit gate." if visit.status == VisitStatus.ON_SITE_PENDING_EXIT else ""),
+                   visit=visit)
+    notify_role(VmsRole.SECURITY, NotificationEvent.VISIT_TERMINATED, "Pass deactivated",
+                "{} ({}) pass deactivated; {}.".format(
+                    visit.visitor.full_name, visit.reference,
+                    "visitor still on-site, record exit" if visit.status == VisitStatus.ON_SITE_PENDING_EXIT else "deny entry"),
+                visit=visit)
+    if as_role == VmsRole.ADMIN:
+        notify_user(visit.host.user, NotificationEvent.VISIT_TERMINATED, "Visit terminated by Admin",
+                    "{} ({}): {}".format(visit.visitor.full_name, visit.reference, reason.strip()), visit=visit)
+    return visit
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-034 Decide Visit Extension (VMS-BR-193/194)
+# --------------------------------------------------------------------------
+
+def _extendable(visit):
+    visit_pass = getattr(visit, "visit_pass", None)
+    if visit.status not in (VisitStatus.PASS_ACTIVE, VisitStatus.ON_SITE) or visit_pass is None or not visit_pass.is_active:
+        raise Conflict("Only an active visit can be extended.", code="not_active")
+    return visit_pass
+
+
+def _apply_extension(visit, visit_pass, new_until):
+    visit_pass.valid_until = new_until
+    visit_pass.save(update_fields=["valid_until"])
+    visit.scheduled_end = new_until
+    visit.save(update_fields=["scheduled_end", "updated_at"])
+
+
+@transaction.atomic
+def request_extension(actor, reference, requested_valid_until, reason):
+    visit = VisitRequest.objects.select_for_update(of=("self",)).select_related("visitor", "host__user").filter(
+        reference=reference).first()
+    if visit is None:
+        raise NotFound("Visit not found.")
+    host = host_extrainfo(actor)
+    is_visit_host = host is not None and host.pk == visit.host_id
+    admin = admin_covers(actor, zones=visit_zone_set(visit))
+    if not (is_visit_host or admin):
+        raise NotAuthorized("Only the visit's Host or an authorised Admin can request an extension.")
+    visit_pass = _extendable(visit)
+    if not requested_valid_until or requested_valid_until <= visit_pass.valid_until:
+        raise ValidationFailed("The new end must be later than the current validity.",
+                               details={"requested_valid_until": ["invalid"]})
+    max_minutes = visit.policy_snapshot["max_visit_duration_minutes"]
+    within_max = (requested_valid_until - visit_pass.valid_from) <= minutes(max_minutes)
+    role = VmsRole.HOST if is_visit_host else VmsRole.ADMIN
+    if within_max:
+        # UC-034 alt flow: within the maximum no Admin exception is needed.
+        old_until = visit_pass.valid_until
+        _apply_extension(visit, visit_pass, requested_valid_until)
+        audit.record(actor, role, "VISIT_EXTENDED_WITHIN_MAX", visit, visitor=visit.visitor,
+                     metadata={"from": old_until, "to": requested_valid_until})
+        notify_visitor(visit.visitor, NotificationEvent.VISIT_EXTENDED, "Visit extended",
+                       "Visit {} now ends at {}.".format(visit.reference, requested_valid_until.strftime("%d %b %H:%M")),
+                       visit=visit)
+        return None, visit
+    if ExtensionRequest.objects.filter(visit=visit, status=ExtensionStatus.PENDING).exists():
+        raise Conflict("An extension request is already pending for this visit.", code="extension_pending")
+    if not (reason or "").strip():
+        raise ValidationFailed("A reason is required for an extension beyond the maximum.", details={"reason": ["required"]})
+    extension = ExtensionRequest.objects.create(
+        visit=visit, requested_by=actor, requested_by_role=role, current_valid_until=visit_pass.valid_until,
+        requested_valid_until=requested_valid_until, reason=reason.strip(),
+        assigned_admin=route_admin(visit_zone_set(visit)),
+    )
+    audit.record(actor, role, "EXTENSION_REQUESTED", extension, visitor=visit.visitor,
+                 metadata={"requested_valid_until": requested_valid_until})
+    if extension.assigned_admin and extension.assigned_admin != actor:
+        notify_user(extension.assigned_admin, NotificationEvent.REQUEST_PENDING_FOR_ADMIN, "Visit extension request",
+                    "{} ({}) requests validity until {}.".format(visit.visitor.full_name, visit.reference,
+                                                               requested_valid_until.strftime("%d %b %H:%M")),
+                    visit=visit)
+    return extension, visit
+
+
+@transaction.atomic
+def decide_extension(actor, extension_id, decision, note=""):
+    extension = ExtensionRequest.objects.select_for_update(of=("self",)).select_related("visit", "visit__visitor").filter(
+        pk=extension_id).first()
+    if extension is None:
+        raise NotFound("Extension request not found.")
+    visit = VisitRequest.objects.select_for_update(of=("self",)).get(pk=extension.visit_id)
+    if not admin_covers(actor, zones=visit_zone_set(visit)):
+        raise NotAuthorized("Only an authorised Admin can decide extensions beyond the maximum (VMS-BR-194).")
+    if extension.status != ExtensionStatus.PENDING:
+        raise Conflict("This extension request is already decided.", code="not_pending")
+    extension.decided_by, extension.decided_at, extension.decision_note = actor, now(), note
+    if decision == "APPROVE":
+        visit_pass = _extendable(visit)
+        _apply_extension(visit, visit_pass, extension.requested_valid_until)
+        workflow.apply(visit, "EXTENSION_APPROVED", actor=actor, actor_role=VmsRole.ADMIN,
+                       note="Validity extended to {}".format(extension.requested_valid_until))
+        extension.status = ExtensionStatus.APPROVED
+        notify_visitor(visit.visitor, NotificationEvent.VISIT_EXTENDED, "Visit extension approved",
+                       "Visit {} now ends at {}.".format(visit.reference,
+                                                        extension.requested_valid_until.strftime("%d %b %H:%M")),
+                       visit=visit)
+    elif decision == "REJECT":
+        extension.status = ExtensionStatus.REJECTED
+    else:
+        raise ValidationFailed("decision must be APPROVE or REJECT.", details={"decision": [decision]})
+    extension.save()
+    audit.record(actor, VmsRole.ADMIN, "EXTENSION_" + decision, extension, visitor=visit.visitor, message=note)
+    if extension.requested_by and extension.requested_by != actor:
+        notify_user(extension.requested_by, NotificationEvent.VISIT_EXTENDED,
+                    "Extension {}".format(extension.status.lower()),
+                    "Extension for {} was {}.".format(visit.reference, extension.status.lower()), visit=visit,
+                    email=False)
+    return extension
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-037 Expire Pending Visit Request (VMS-BR-062/200)
+# --------------------------------------------------------------------------
+
+def expire_visit(visit, current=None):
+    current = current or now()
+    if visit.status != VisitStatus.PENDING_HOST_APPROVAL:
+        return False  # UC-037 exception flow: already decided, no expiry applied
+    workflow.apply(visit, "EXPIRE", actor_role=VmsRole.SYSTEM, note="Approval timeout elapsed")
+    audit.record(None, VmsRole.SYSTEM, "VISIT_EXPIRED", visit, visitor=visit.visitor,
+                 metadata={"deadline": visit.approval_deadline})
+    notify_visitor(visit.visitor, NotificationEvent.REQUEST_EXPIRED, "Visit request expired",
+                   "Your visit request {} expired because the host did not respond in time.".format(visit.reference),
+                   visit=visit)  # AFR-201
+    if visit.registered_by:
+        notify_user(visit.registered_by, NotificationEvent.REQUEST_EXPIRED, "Walk-in request expired",
+                    "{} ({}) expired without a host decision.".format(visit.visitor.full_name, visit.reference),
+                    visit=visit, email=False)
+    return True
+
+
+def expire_pending_requests(current=None):
+    current = current or now()
+    count = 0
+    due = VisitRequest.objects.filter(status=VisitStatus.PENDING_HOST_APPROVAL, approval_deadline__lte=current)
+    for pk in due.values_list("pk", flat=True):
+        with transaction.atomic():
+            visit = VisitRequest.objects.select_for_update(of=("self",)).select_related("visitor").get(pk=pk)
+            if visit.approval_deadline and visit.approval_deadline <= current and expire_visit(visit, current):
+                count += 1
+    return count
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-040 Send Pending Approval Reminder (ISS-VMS-018: configured instants)
+# --------------------------------------------------------------------------
+
+def send_pending_reminders(current=None):
+    current = current or now()
+    sent = 0
+    pending = VisitRequest.objects.filter(status=VisitStatus.PENDING_HOST_APPROVAL, approval_deadline__gt=current)
+    for pk in pending.values_list("pk", flat=True):
+        with transaction.atomic():
+            visit = VisitRequest.objects.select_for_update(of=("self",)).select_related("visitor", "host__user").get(pk=pk)
+            if visit.status != VisitStatus.PENDING_HOST_APPROVAL:
+                continue  # suppressed: no longer pending
+            snapshot = visit.policy_snapshot
+            offsets = snapshot.get("reminder_offsets_minutes") or []
+            window_start = visit.approval_deadline - minutes(snapshot["approval_timeout_minutes"])
+            done = set(visit.reminders_sent or [])
+            due = [o for o in offsets if o not in done and window_start + minutes(o) <= current]
+            if not due:
+                continue
+            remaining = visit.approval_deadline - current
+            notify_user(visit.host.user, NotificationEvent.APPROVAL_REMINDER, "Reminder: visit request pending",
+                        "{} ({}) is still awaiting your decision; it expires in {} minutes.".format(
+                            visit.visitor.full_name, visit.reference, int(remaining.total_seconds() // 60)),
+                        visit=visit)
+            visit.reminders_sent = sorted(done | set(due))
+            visit.save(update_fields=["reminders_sent", "updated_at"])
+            sent += 1
+    return sent
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-038 Automatically Check Out Visit (VMS-BR-101/105)
+# --------------------------------------------------------------------------
+
+def auto_check_out(current=None):
+    from .gate import complete_visit
+    current = current or now()
+    count = 0
+    due = VisitRequest.objects.filter(status__in=VisitStatus.ON_CAMPUS, visit_pass__valid_until__lte=current)
+    for pk in due.values_list("pk", flat=True):
+        with transaction.atomic():
+            visit = VisitRequest.objects.select_for_update(of=("self",)).select_related("visitor", "host__user").get(pk=pk)
+            visit_pass = getattr(visit, "visit_pass", None)
+            if visit.status not in VisitStatus.ON_CAMPUS or visit.check_out_at or visit_pass is None:
+                continue  # never a second checkout
+            if visit_pass.valid_until > current:
+                continue
+            complete_visit(visit, LogMethod.AUTO, actor_role=VmsRole.SYSTEM, at=visit_pass.valid_until)
+            count += 1
+    return count
+
+
+def run_scheduled_tasks(current=None):
+    """Entry point for cron / Celery beat (``manage.py vms_run_scheduled_tasks``)."""
+    from .gate import reconcile_offline_events
+    current = current or now()
+    return {
+        "expired": expire_pending_requests(current),
+        "reminders": send_pending_reminders(current),
+        "auto_checked_out": auto_check_out(current),
+        "offline_reconciled": len(reconcile_offline_events()),
+    }
diff --git a/FusionIIIT/applications/visitor_management/services/registration.py b/FusionIIIT/applications/visitor_management/services/registration.py
new file mode 100644
index 0000000..b582724
--- /dev/null
+++ b/FusionIIIT/applications/visitor_management/services/registration.py
@@ -0,0 +1,747 @@
+"""Registration and approval services.
+
+VMS-UC-010 pre-register, VMS-UC-013 host decision, VMS-UC-014 pre-authorisation,
+VMS-UC-017 walk-in, VMS-UC-033 contingency approval, VMS-UC-035 same-day urgent
+exception, VMS-UC-008/009 bulk and special-event handling.
+"""
+
+import csv
+import datetime
+import io
+
+from django.db import transaction
+from django.utils.dateparse import parse_datetime
+
+from applications.globals.models import ExtraInfo
+
+from .. import audit, workflow
+from ..constants import (
+    BulkListKind,
+    Channel,
+    Checkpoint,
+    EventStatus,
+    IdDocumentType,
+    IntegrationKey,
+    NotificationEvent,
+    PassType,
+    VisitStatus,
+    VmsRole,
+)
+from ..errors import Conflict, NotAuthorized, NotFound, RateLimited, Unavailable, ValidationFailed
+from ..matching import identity_keys, strong_identity_q
+from ..models import BulkVisitorList, HostProfile, PreAuthorization, Visitor, VisitorEvent, VisitRequest
+from ..notifications import notify_role, notify_user, notify_visitor
+from ..selectors import (
+    admin_covers,
+    host_extrainfo,
+    integration_usable,
+    is_eligible_host,
+    now,
+    policy_snapshot,
+    security_covers,
+)
+from .common import (
+    generate_reference,
+    issue_pass,
+    issue_visitor_token,
+    minutes,
+    raise_registry_alerts,
+    registry_check,
+    restricted_zone_ids,
+    route_admin,
+    validate_schedule,
+    within_visiting_hours,
+    zones_from_codes,
+    find_preauthorization,
+    find_vip_permission,
+)
+from .configuration import require_admin, require_campus_admin
+
+IDENTITY_FIELDS = ("full_name", "id_doc_type", "id_doc_number", "phone", "email")
+
+
+def resolve_host(host_id):
+    """VMS-BR-185 host recognition through the institutional directory (AFR-217/218)."""
+    if not integration_usable(IntegrationKey.CAMPUS_ID, default=True):
+        raise Unavailable("Host lookup through the campus directory is currently unavailable.", code="host_lookup_unavailable")
+    host = ExtraInfo.objects.select_related("user", "department").filter(pk=str(host_id)).first()
+    if not is_eligible_host(host):
+        raise ValidationFailed("Select a valid Faculty/Staff host.", details={"host_id": ["Not a valid host."]})
+    return host
+
+
+def host_is_available(host, at=None):
+    profile = HostProfile.objects.filter(extra_info=host).first()
+    if profile is None or profile.is_available:
+        return True
+    return bool(profile.unavailable_until and profile.unavailable_until <= (at or now()))
+
+
+def _identity_payload(data):
+    return {k: (data.get(k) or "").strip() for k in IDENTITY_FIELDS}
+
+
+def _validate_identity(identity):
+    """VMS-BR-037 mandatory fields, VMS-BR-186/187 identity document."""
+    errors = {}
+    if not identity["full_name"]:
+        errors["full_name"] = ["This field is required."]
+    if not identity["phone"]:
+        errors["phone"] = ["This field is required."]
+    if identity["id_doc_type"] not in {c for c, _ in IdDocumentType.CHOICES}:
+        errors["id_doc_type"] = ["Must be one of Passport, National ID, Driver's License or Other (VMS-BR-187)."]
+    if len(identity["id_doc_number"].replace(" ", "")) < 4:
+        errors["id_doc_number"] = ["A valid government-issued ID document number is required (VMS-BR-186)."]
+    if errors:
+        raise ValidationFailed("Registration details are incomplete or invalid.", details=errors)
+
+
+def _visitor_for(identity, extra, visitor_token_hash=None):
+    """Re-use the caller's own visitor profile when they present their portal token."""
+    visitor = None
+    if visitor_token_hash:
+        visitor = Visitor.objects.filter(access_token_hash=visitor_token_hash).first()
+    if visitor is None:
+        visitor = Visitor(**identity)
+        is_new = True
+    else:
+        for key, value in identity.items():
+            setattr(visitor, key, value)
+        is_new = False
+    visitor.organization = extra.get("organization", visitor.organization or "") or ""
+    if extra.get("id_document"):
+        visitor.id_document = extra["id_document"]
+    if extra.get("photo"):
+        visitor.photo = extra["photo"]
+    visitor.save()
+    return visitor, is_new
+
+
+def _duplicate_exists(identity, host, start, end):
+    """VMS-BR-038: an open request for the same visitor, host and overlapping time."""
+    keys = identity_keys(**{k: identity[k] for k in ("full_name", "id_doc_number", "phone", "email")})
+    return VisitRequest.objects.filter(
+        host=host, status__in=VisitStatus.OPEN, scheduled_start__lt=end, scheduled_end__gt=start,
+    ).filter(strong_identity_q(keys, prefix="visitor__")).exists()
+
+
+def _host_zone_check(zones, snapshot):
+    restricted = restricted_zone_ids(snapshot)
+    blocked = [z.code for z in zones if z.pk in restricted]
+    if blocked:
+        raise ValidationFailed(
+            "Restricted zones need a temporary Admin elevation or a VIP override.",
+            code="restricted_zone", details={"permitted_zones": blocked})
+
+
+# --------------------------------------------------------------------------
+# VMS-UC-010 Pre-register Visit
+# --------------------------------------------------------------------------
+
+def pre_register(data, visitor_token_hash=None):
+    current = now()
+    snapshot = policy_snapshot()
+    identity = _identity_payload(data)
+    _validate_identity(identity)
+    host = resolve_host(data.get("host_id"))
+    purpose = data.get("purpose")
+    start, end = data.get("scheduled_start"), data.get("scheduled_end")
+    if not start or not end:
+        raise ValidationFailed("Visit schedule is required.", details={"scheduled_start": ["required"]})
+    if start <= current:
+        raise ValidationFailed("Visit must be scheduled in the future.", details={"scheduled_start": ["past"]})
+    validate_schedule(snapshot, start, end, current)
+    zones = zones_from_codes(data.get("requested_zones"), "requested_zones")
+
+    keys = identity_keys(identity["full_name"], identity["id_doc_number"], identity["phone"], identity["email"])
+    result = registry_check(keys, Checkpoint.PRE_REGISTRATION, current)
+    if result.disqualifying:
+        # VMS-BR-051 reject, VMS-BR-117 alert. No request is created.
+        raise_registry_alerts(result, Checkpoint.PRE_REGISTRATION, actor_role=VmsRole.VISITOR, identity=identity)
+        raise NotAuthorized("The visit request could not be accepted. Please contact the campus security office.",
+                            code="registration_rejected")
+    if _duplicate_exists(identity, host, start, end):
+        raise Conflict("A visit request for this visitor, host and time already exists.", code="duplicate_request")
+
+    vip = find_vip_permission(keys, start, end)
+    preauth = None if vip else find_preauthorization(host, keys, start, end, zones, purpose)
+    window_ok = (start - current) >= minutes(snapshot["advance_registration_minutes"])
+    urgent = bool(data.get("is_urgent"))
+
+    if vip:
+        action = "SUBMIT_VIP"
+    elif preauth:
+        action = "SUBMIT_PREAUTHORIZED"
+    elif window_ok:
+        action = "SUBMIT_STANDARD"
+    elif urgent and start.date() == current.date():
+        action = "SUBMIT_URGENT"  # VMS-BR-203
+    else:
+        raise ValidationFailed(
+            "Visits must be registered at least {} minutes ahead (VMS-BR-202). Mark same-day urgent visits as urgent "
+            "for Admin review.".format(snapshot["advance_registration_minutes"]),
+            code="advance_window", details={"scheduled_start": ["inside advance-registration window"]})
+
+    with transaction.atomic():
+        visitor, is_new = _visitor_for(identity, data, visitor_token_hash)
+        visit = VisitRequest(
+            reference=generate_reference(), visitor=visitor, host=host, purpose=purpose,
+            purpose_details=data.get("purpose_details", ""), scheduled_start=start, scheduled_end=end,
+            channel=Channel.ONLINE, status="", is_urgent=urgent and action == "SUBMIT_URGENT",
+            policy_id=None, policy_snapshot=snapshot, submitted_at=current,
+            preauthorization=preauth, vip_permission=vip, watchlist_flag=bool(result.flags),
+        )
+        if snapshot.get("version"):
+            from ..models import AccessPolicy
+            visit.policy = AccessPolicy.objects.filter(version=snapshot["version"]).first()
+        if action == "SUBMIT_STANDARD":
+            visit.approval_deadline = current + minutes(snapshot["approval_timeout_minutes"])
+        if action == "SUBMIT_URGENT":
+            visit.assigned_admin = route_admin(zones)
+        visit.save()
+        visit.requested_zones.set(zones)
+        workflow.apply(visit, action, actor_role=VmsRole.VISITOR)
+        if result.flags:
+            raise_registry_alerts(result, Checkpoint.PRE_REGISTRATION, actor_role=VmsRole.VISITOR, visitor=visitor,
+                                  visit=visit, identity=identity)
+
+        token = issue_visitor_token(visitor) if is_new else None
+        audit.record(None, VmsRole.VISITOR, "VISIT_PRE_REGISTERED", visit, visitor=visitor,
+                     message="{} submitted ({})".format(visit.reference, action),
+                     metadata={"status": visit.status, "host": host.pk})
+        submitted_msg = "Your visit request {} with {} has been received. Status: {}.".format(
+            visit.reference, host.user.get_full_name() or host.user.username, visit.get_status_display())
+        if token:
+            submitted_msg += "\nVisitor portal access token: {}".format(token)
+        notify_visitor(visitor, NotificationEvent.REQUEST_SUBMITTED, "Visit request received", submitted_msg, visit=visit)
+
+        if action == "SUBMIT_STANDARD":
+            notify_user(host.user, NotificationEvent.REQUEST_PENDING_FOR_HOST, "Visit request awaiting your decision",
+                        "{} has requested a visit on {} ({}).".format(visitor.full_name, start.strftime("%d %b %H:%M"),
+                                                                     visit.reference), visit=visit)
+        elif action == "SUBMIT_URGENT":
+            if visit.assigned_admin:
+                notify_user(visit.assigned_admin, NotificationEvent.REQUEST_PENDING_FOR_ADMIN,
+                            "Same-day urgent visit needs an exception decision",
+                            "{} requested an urgent visit with {} ({}).".format(
+                                visitor.full_name, host.user.get_full_name() or host.user.username, visit.reference),
+                            visit=visit)
+        else:
+            pass_type = PassType.VIP if action == "SUBMIT_VIP" else PassType.PRE_REGISTERED
+            pass_zones = zones if zones else ([] if vip else list(preauth.permitted_zones.all()))
+            if not vip:
+                pass_zones = [z for z in pass_zones if z.pk not in restricted_zone_ids(snapshot)]
+            issue_pass(visit, pass_type, start, end, pass_zones, actor_role=VmsRole.SYSTEM, visitor_token=None)
+            notify_user(host.user, NotificationEvent.REQUEST_APPROVED, "Visit authorised by bypass",
+                        "{} ({}) was authorised through {}.".format(
+                            visitor.full_name, visit.reference, "VIP override" if vip else "your pre-authorization"),
+                        visit=visit, email=False)
+            notify_role(VmsRole.SECURITY, NotificationEvent.REQUEST_APPROVED, "Expected visitor",
+                        "{} expected {} ({}).".format(visitor.full_name, start.strftime("%d %b %H:%M"), visit.reference),
+                        visit=visit)
+        return visit, token
