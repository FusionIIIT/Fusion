+    "BW-VMS-04 R3": ("visit", "GATE_CHECK_IN"),
+    "BW-VMS-04 R4": ("visit", "GATE_CHECK_OUT"),
+    "BW-VMS-05 R1": ("vip_permission", "VipPermission.is_active"),
+    "BW-VMS-05 R2": ("visit", "SUBMIT_VIP"),
+    "BW-VMS-05 R3": ("visit", "GATE_CHECK_IN"),
