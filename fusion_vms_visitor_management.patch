+# VMS-UC-021 / 031 / 038 checkout (VMS-BR-105)
+# --------------------------------------------------------------------------
+
+ACTION_FOR_METHOD = {
+    LogMethod.KIOSK: "SELF_CHECK_OUT",
+    LogMethod.APP: "SELF_CHECK_OUT",
+    LogMethod.AUTO: "AUTO_CHECK_OUT",
+    LogMethod.OFFLINE: "OFFLINE_CHECK_OUT",
