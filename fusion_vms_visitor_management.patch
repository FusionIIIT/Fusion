+    "BW-VMS-06 R3": ("visit", "GATE_CHECK_IN"),
+    "BW-VMS-06 R4": ("visit", "GATE_CHECK_OUT"),
+    "BW-VMS-07 R1": ("visit", "WALKIN_HOST_UNAVAILABLE"),
