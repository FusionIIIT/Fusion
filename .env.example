# Fusion-Integrated — copy to .env for local development.
# .env is gitignored. Real environment variables always win.

DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production, no fallback there.
# python -c 'import secrets; print(secrets.token_urlsafe(64))'
# DJANGO_SECRET_KEY=

DB_NAME=fusion_integrated
DB_USER=fusion_admin
# Set this to whatever your local Postgres uses.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Must stay 0 if PgBouncer is ever put in front in transaction mode.
DB_CONN_MAX_AGE=0

# --- Fusion_System_Administrator = the IAM -----------------------------------
# Identity, RBAC and the common directory (student/faculty info) all live there.
# This service has no user table of its own.
IAM_BASE_URL=http://127.0.0.1:8001
IAM_API_PREFIX=/api
# Server-to-server credential, for directory reads with no user session behind
# them (a report listing 300 applicants by name). Mint it on the IAM with:
#     manage.py service_token --issue fusion-integrated
# Sent as `Authorization: Service fsvc_...` — a different scheme from a user
# session, so the IAM can never mistake this service for a person.
IAM_SERVICE_TOKEN=
IAM_TIMEOUT_SECONDS=5
IAM_SESSION_CACHE_SECONDS=60
# Must differ from the console's cookie: on one hostname they overwrite each other.
IAM_AUTH_COOKIE_NAME=fusion_session

# Optional. Without these, cache falls back to in-process LocMem.
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# REDIS_BROKER_URL=redis://127.0.0.1:6380/0

# Documents are Google Drive links, so nothing is written here any more. The
# path only has to stay resolvable for rows attached before that switch.
# Must NOT be inside the repo. Defaults to
# ~/.local/share/fusion-integrated/uploads.
# PLACEMENT_UPLOAD_ROOT=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
